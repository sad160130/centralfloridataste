---
import Base from '../../layouts/Base.astro';
import GradeAttribution from '../../components/GradeAttribution.astro';
import { TIERS, tierStats, coverage, allTiers } from '../../lib/violations.js';

// /violations/high-priority/, /violations/intermediate/, /violations/basic/.
// emergency-orders.astro is a static sibling and takes precedence over this route.
export function getStaticPaths() {
  return ['high-priority', 'intermediate', 'basic'].map((t) => ({
    params: { tier: t },
    props: { tier: t },
  }));
}

const { tier } = Astro.props;
const s = tierStats(tier);
const cov = coverage();
const others = allTiers().filter((t) => t.slug !== tier);

const pageUrl = new URL(`/violations/${tier}/`, Astro.site).href;
const orgId = `${new URL('/', Astro.site).href}#organization`;

const seoTitle = `${s.title} in Florida Restaurants`.slice(0, 60);
const seoDescription = (
  `What a ${s.label.toLowerCase()} violation means in a Florida restaurant inspection: ` +
  `${s.total.toLocaleString('en-US')} recorded across ${cov.published.toLocaleString('en-US')} restaurants, and which carry the most.`
).slice(0, 155);

const faqs = [
  {
    q: `What is a ${s.label.toLowerCase()} violation in a Florida restaurant inspection?`,
    a: s.what,
  },
  {
    q: `How many ${s.label.toLowerCase()} violations are typical?`,
    a: `Across the ${cov.published.toLocaleString('en-US')} restaurants we publish, inspectors recorded ${s.total.toLocaleString('en-US')} ${s.label.toLowerCase()} violations at the most recent visit — an average of ${s.avgPerRestaurant} per restaurant. ${s.clean.toLocaleString('en-US')} restaurants had none at all, and the highest recorded at a single restaurant was ${s.max}.`,
  },
  {
    q: `How much does a ${s.label.toLowerCase()} violation affect the grade?`,
    a: `In the score we calculate, each ${s.label.toLowerCase()} violation deducts ${s.penalty} ${s.penalty === 1 ? 'point' : 'points'} from a starting 100. Florida itself issues no grade; the deduction is ours, and the formula is published in full on our methodology page.`,
  },
];

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: s.title,
  url: pageUrl,
  description: seoDescription,
  publisher: { '@id': orgId },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: s.worst.length,
    itemListElement: s.worst.map((r, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: new URL(`${r.url}/`, Astro.site).href,
      name: r.name,
    })),
  },
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: 'Violations', item: new URL('/violations/', Astro.site).href },
    { '@type': 'ListItem', position: 3, name: s.title, item: pageUrl },
  ],
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<Base title={seoTitle} description={seoDescription}>
  <script type="application/ld+json" slot="jsonld" set:html={JSON.stringify([collectionSchema, breadcrumbSchema, faqSchema])} />

  <main>
    <nav aria-label="Breadcrumb">
      <a href="/">Home</a> &rsaquo; <a href="/violations/">Violations</a> &rsaquo; <span>{s.label}</span>
    </nav>

    <article>
      <p class="eyebrow">Reference · Florida DBPR</p>
      <h1>{s.title} in Florida Restaurants</h1>

      <div class="statrow">
        <div class="stat"><b>{s.total.toLocaleString('en-US')}</b><span>Recorded</span></div>
        <div class="stat"><b>{s.affected.toLocaleString('en-US')}</b><span>Restaurants affected</span></div>
        <div class="stat"><b>{s.pctAffected}%</b><span>Of all published</span></div>
        <div class="stat"><b>&minus;{s.penalty}</b><span>Points each</span></div>
      </div>

      <p class="lead">{s.what}</p>
      <p>{s.why}</p>
      <p>{s.fix}</p>

      <p class="src">
        Coverage: we publish inspection records for {cov.published.toLocaleString('en-US')} of the
        {' '}{cov.licensed.toLocaleString('en-US')} licensed food service establishments across
        {' '}{cov.counties} Central Florida counties. Every figure on this page describes the
        {' '}{cov.published.toLocaleString('en-US')} we publish, not the full licensed roster.
        {cov.nr > 0 && (
          <>
            {' '}{cov.nr}{' '}{cov.nr === 1 ? 'restaurant is' : 'restaurants are'} excluded from
            grade percentages, having no recent scoreable inspection on file;{' '}
            {cov.graded.toLocaleString('en-US')} are graded.
          </>
        )}
      </p>

      <GradeAttribution />

      <section aria-labelledby="dist-h">
        <h2 id="dist-h">How many restaurants carry {s.label.toLowerCase()} violations</h2>
        <p>
          Counted from each restaurant&rsquo;s most recent inspection. {s.clean.toLocaleString('en-US')}
          {' '}of {cov.published.toLocaleString('en-US')} had none; the most recorded at any single
          restaurant was {s.max}.
        </p>
        <table class="vtable">
          <thead>
            <tr><th scope="col">{s.label} violations</th><th scope="col">Restaurants</th><th scope="col">Share</th></tr>
          </thead>
          <tbody>
            {s.buckets.map((b) => (
              <tr>
                <th scope="row">{b.label}</th>
                <td class="vt-num">{b.count.toLocaleString('en-US')}</td>
                <td class="vt-num">{b.pct}%</td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>

      <section aria-labelledby="county-h">
        <h2 id="county-h">{s.label} violations by county</h2>
        <p>
          Ranked by violations per 100 restaurants, so counties of different sizes can be compared.
        </p>
        <table class="vtable">
          <thead>
            <tr><th scope="col">County</th><th scope="col">Restaurants</th><th scope="col">{s.label}</th><th scope="col">Per restaurant</th></tr>
          </thead>
          <tbody>
            {s.byCounty.map((c) => (
              <tr>
                <th scope="row"><a href={`/${c.slug}-county/restaurant-inspections/`}>{c.name} County</a></th>
                <td class="vt-num">{c.restaurants.toLocaleString('en-US')}</td>
                <td class="vt-num">{c.total.toLocaleString('en-US')}</td>
                <td class="vt-num">{c.per100}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>

      <section aria-labelledby="worst-h">
        <h2 id="worst-h">Restaurants with the most {s.label.toLowerCase()} violations</h2>
        <p>
          The {s.worst.length} highest counts recorded at a single inspection, as logged by DBPR.
          Every figure below is the count from that restaurant&rsquo;s most recent visit.
        </p>
        <ol class="faillist">
          {s.worst.map((r) => (
            <li class="fail">
              <p class="fail-head">
                <span class="fail-score">{r.count}</span>
                <a class="fail-name" href={`${r.url}/`}>{r.name}</a>
                <span class="fail-city">{r.city} &middot; {r.county} County</span>
              </p>
              <p class="fail-viol">
                {r.high} high-priority &middot; {r.intermediate} intermediate &middot; {r.basic} basic
                {r.score != null && <> &middot; grade {r.grade} ({r.score}/100)</>}
                {r.dateText && <> &middot; inspected {r.dateText}</>}
              </p>
            </li>
          ))}
        </ol>
      </section>

      <section aria-labelledby="more-h">
        <h2 id="more-h">The other violation tiers</h2>
        <ul class="link-list">
          {others.map((t) => (
            <li><a href={`/violations/${t.slug}/`}>{t.title}</a> &mdash; {t.total.toLocaleString('en-US')} recorded, &minus;{t.penalty} {t.penalty === 1 ? 'point' : 'points'} each</li>
          ))}
          <li><a href="/violations/emergency-orders/">Emergency orders</a> &mdash; when the state suspends a licence outright</li>
          <li><a href="/violations/">All violation types explained</a></li>
          <li><a href="/methodology/">How we calculate health grades</a></li>
        </ul>
      </section>

      <section id="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Common questions about {s.label.toLowerCase()} violations</h2>
        <dl class="faq">{faqs.map((f) => (<><dt>{f.q}</dt><dd>{f.a}</dd></>))}</dl>
      </section>
    </article>
  </main>

  <style>
    .src { font-size: 0.84rem; color: var(--mute); font-style: italic; margin: 0.5rem 0 0; }
    table.vtable { width: 100%; max-width: 42rem; border-collapse: collapse; margin: 1rem 0 0; font-size: 0.92rem; }
    table.vtable th, table.vtable td { text-align: left; padding: 0.55rem 0.7rem; border-bottom: 1px solid var(--line); }
    table.vtable thead th { font-family: var(--mono); font-size: 0.64rem; letter-spacing: 0.07em; text-transform: uppercase; color: var(--mute); font-weight: 600; }
    .vt-num { font-family: var(--mono); font-size: 0.86rem; }
    ol.faillist { list-style: none; padding: 0; margin: 1rem 0 0; display: grid; gap: 0.7rem; }
    .fail { padding: 0.8rem 1rem; background: var(--surface); border: 1px solid var(--line); border-left: 4px solid var(--citrus); border-radius: 2px; }
    .fail-head { margin: 0; display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }
    .fail-score { font-family: var(--mono); font-weight: 700; font-size: 0.8rem; color: #fff; background: var(--citrus-ink); padding: 0.15rem 0.5rem; border-radius: 2px; }
    .fail-name { font-weight: 700; color: var(--ink); }
    .fail-city { font-family: var(--mono); font-size: 0.68rem; letter-spacing: 0.05em; text-transform: uppercase; color: var(--mute); }
    .fail-viol { margin: 0.2rem 0 0; font-family: var(--mono); font-size: 0.72rem; letter-spacing: 0.03em; color: var(--mute); }
    dl.faq { margin: 1rem 0 0; }
    dl.faq dt { font-weight: 700; margin: 0.9rem 0 0.25rem; }
    dl.faq dd { margin: 0; color: var(--ink-2); font-size: 0.95rem; line-height: 1.6; }
  </style>
</Base>
