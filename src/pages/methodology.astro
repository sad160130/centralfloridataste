---
import Base from '../layouts/Base.astro';
import { phase1 } from '../lib/data.js';
import { siteStats } from '../lib/prose.js';
import { allTiers, emergencyStats, coverage } from '../lib/violations.js';

const s = siteStats(phase1);

// Additive Q&A block below. Figures use the same published scope as every other
// page, so the answers reconcile with the county and violation pages.
const tiers = allTiers();
const em = emergencyStats();
const cov = coverage();
const totalInspections = phase1.reduce((n, r) => n + (r.inspection_history || []).length, 0);
const multiVisit = phase1.filter((r) => (r.inspection_history || []).length > 1).length;
const callbacks = phase1.reduce(
  (n, r) => n + (r.inspection_history || []).filter((h) => /call ?back/i.test(h.disposition || '')).length,
  0
);
const hpTier = tiers.find((t) => t.slug === 'high-priority');
const bRows = phase1.filter((r) => r.health_grade === 'B');
const bGrade = bRows.length;
const bClean = bRows.filter((r) => (r.hp_violations || 0) === 0).length;
const bMaxHp = bRows.reduce((m, r) => Math.max(m, r.hp_violations || 0), 0);
const avgVisits = (totalInspections / cov.published).toFixed(1);

const qa = [
  {
    id: 'why-no-grades',
    q: 'Why does Florida not grade restaurants?',
    a: 'Because Florida law never created a grading scheme \u2014 the state publishes the full inspection report instead of reducing it to a letter.',
    more:
      'DBPR inspectors record every violation they find and publish the report, but no statute directs them to turn that into a grade or score the way Los Angeles County and New York City do. The reports are public in full; what is missing is the summary. That gap is the reason this site exists, and it is why every grade here is labelled as ours rather than the state\u2019s.',
  },
  {
    id: 'who-inspects',
    q: 'Who inspects restaurants in Florida?',
    a: 'The Department of Business and Professional Regulation \u2014 DBPR \u2014 through its Division of Hotels and Restaurants.',
    more:
      'DBPR covers restaurants, bars, food trucks, caterers and hotel kitchens. It does not cover everything that serves food: school cafeterias, hospitals, nursing homes and grocery-store delis fall to the Department of Health or the Department of Agriculture instead. Every record on this site comes from DBPR, so a kitchen inspected by another agency will not appear here.',
  },
  {
    id: 'public-record',
    q: 'Are restaurant inspections public record in Florida?',
    a: 'Yes. Every completed inspection is a public record under Florida\u2019s public records law, free to anyone who asks.',
    more:
      'DBPR publishes them itself and the underlying data can be downloaded in bulk. Nothing here is privileged or purchased: we take the same public extract anyone can, and what we add is putting it in one place and scoring it consistently. This site currently holds ' +
      totalInspections.toLocaleString('en-US') + ' inspection records covering ' +
      cov.published.toLocaleString('en-US') + ' restaurants.',
  },
  {
    id: 'how-often',
    q: 'How often does Florida inspect restaurants?',
    a: 'Most restaurants are inspected one to four times a year, with higher-risk kitchens visited more often.',
    more:
      'Frequency is set by the food an operation handles and its risk category, and any complaint can trigger an extra unannounced visit. In our records ' +
      multiVisit.toLocaleString('en-US') + ' of ' + cov.published.toLocaleString('en-US') +
      ' restaurants have more than one inspection on file, averaging ' + avgVisits + ' visits each.',
  },
  {
    id: 'how-many-violations',
    q: 'How many violations before a restaurant is closed?',
    a: 'There is no threshold \u2014 closure depends on what the inspector finds, not on how many violations are counted.',
    more:
      'A restaurant can carry a dozen basic violations and stay open, while a single unresolved hazard \u2014 no running water, a sewage backup, live pests \u2014 can close one the same day. Across the ' +
      cov.published.toLocaleString('en-US') + ' restaurants we publish, inspectors recorded ' +
      hpTier.total.toLocaleString('en-US') + ' high-priority violations in total, and ' + em.total +
      ' restaurants have an emergency order on record.',
  },
  {
    id: 'reopen',
    q: 'Can a restaurant reopen after being closed?',
    a: 'Yes. The suspension lifts once the problem is fixed and an inspector returns to confirm it.',
    more:
      'The restaurant corrects the fault, requests a re-inspection, and an inspector visits again. If the finding is resolved the disposition is recorded as Emergency Order Callback Complied and the restaurant reopens. ' +
      em.complied + ' of the ' + em.total + ' emergency orders in our records ended that way.',
  },
  {
    id: 'callback',
    q: 'What is a callback inspection?',
    a: 'A return visit whose only purpose is to check whether a problem found earlier has actually been fixed.',
    more:
      'A callback is not a routine inspection. It exists to close out a specific earlier finding, and its disposition records the outcome: complied, not complied, or a time extension. Our records contain ' +
      callbacks.toLocaleString('en-US') +
      ' callback inspections. A restaurant with several is not necessarily worse than average \u2014 it means earlier findings were followed up.',
  },
  {
    id: 'b-grade',
    q: 'Is a B grade restaurant safe?',
    a: 'A B means the inspector found real problems but not many of the most serious kind \u2014 no B-grade restaurant we publish carried more than ' +
      bMaxHp + ' high-priority violations.',
    more:
      'In our scale a B is 80 to 89 points, which is roughly two to three intermediate violations or a larger number of basic ones. Of the ' +
      bGrade.toLocaleString('en-US') + ' B-grade restaurants we publish, ' + bClean.toLocaleString('en-US') +
      ' had no high-priority violations at all at their most recent inspection \u2014 so the majority, ' +
      (bGrade - bClean).toLocaleString('en-US') +
      ', had at least one. A B is not a clean bill of health; it means the problems found were fewer or lighter than at a C. The grade is ours rather than the state\u2019s, and the violations behind it are listed on every restaurant page.',
  },
];
const pageUrl = new URL('/methodology/', Astro.site).href;
const orgId = `${new URL('/', Astro.site).href}#organization`;

const seoTitle = 'How We Grade Restaurants — Methodology';
const seoDescription =
  'How Central Florida Restaurant Grades calculates A–F health scores from Florida DBPR public inspection records. Florida does not issue official grades.';

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'How we grade restaurants',
  url: pageUrl,
  description: seoDescription,
  publisher: { '@id': orgId },
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: 'Methodology', item: pageUrl },
  ],
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: qa.map((x) => ({
    '@type': 'Question',
    name: x.q,
    acceptedAnswer: { '@type': 'Answer', text: x.a + ' ' + x.more },
  })),
};
---

<Base title={seoTitle} description={seoDescription}>
  <script
    type="application/ld+json"
    slot="jsonld"
    set:html={JSON.stringify([webPageSchema, breadcrumbSchema, faqSchema])}
  />

  <main>
    <nav aria-label="Breadcrumb">
      <a href="/">Home</a> &rsaquo; <span>Methodology</span>
    </nav>

    <article>
      <p class="eyebrow">Transparency · How we grade</p>
      <h1>How we grade restaurants</h1>
      <p class="lead">
        This method currently grades {s.n.toLocaleString('en-US')} restaurants across {s.counties}
        {' '}Central Florida counties — {s.pctA}% hold an A, and {s.perfect.toLocaleString('en-US')}
        {' '}score a perfect 100. Here is exactly how those grades are calculated.
      </p>

      <div class="prose">
        <h2>The most important thing to know first</h2>
        <p>
          Florida does not assign letter grades or scores to restaurants. The state&rsquo;s Department
          of Business and Professional Regulation (DBPR) inspects food establishments and records
          violations, but it deliberately does not rate or grade them, because each inspection is a
          snapshot of one moment. <strong>The A–F grades and 0–100 scores on this site are calculated
          by us from DBPR&rsquo;s public inspection records using the published method below. They are
          not official Florida grades.</strong> We show our exact method so you can judge it for
          yourself.
        </p>

        <h2>Where the inspection data comes from</h2>
        <p>
          We use the DBPR Division of Hotels &amp; Restaurants public-records extracts for District 4,
          which covers the eight Central Florida counties: Orange, Brevard, Volusia, Seminole, Osceola,
          Lake, St. Lucie, and Indian River. DBPR refreshes these files regularly. Each record includes
          the establishment&rsquo;s licensed name and address, every inspection this fiscal year, the
          disposition of each visit, and the count of violations by severity tier — high-priority,
          intermediate, and basic. See our <a href="/data-sources/">data &amp; sources</a> page for the
          full list.
        </p>

        <h2>How we calculate the score</h2>
        <p>Every restaurant starts at 100 points. From its most recent completed inspection we subtract:</p>
        <ul>
          <li>8 points per high-priority violation (the items most directly tied to foodborne illness — temperature control, cross-contamination, pest activity, hygiene)</li>
          <li>3 points per intermediate violation</li>
          <li>1 point per basic violation</li>
          <li>An additional penalty when the inspection ended in enforcement: a warning, an administrative complaint, or an emergency closure order</li>
          <li>A further deduction if the restaurant had any emergency closure in the trailing year, even if since corrected</li>
        </ul>
        <p>
          The result is clamped to a 0–100 range, and we keep the raw number. Grades follow standard
          bands: <strong>A is 90+, B is 80–89, C is 70–79, D is 60–69, and F is below 60.</strong> A
          restaurant with no completed inspection in the current period is marked <strong>Not Rated</strong>
          rather than given a default grade.
        </p>

        <h2>How we match restaurants to ratings and locations</h2>
        <p>
          DBPR data has no map coordinates, ratings, or hours, so we match each licensed establishment
          to its Google Maps listing using its name, address, and location. We verify every match on
          both location and name agreement, and <strong>we only publish matches we&rsquo;re confident
          in</strong> — restaurants whose match is uncertain are held back rather than shown with
          possibly-wrong information. Across our publishable list, about 97% of active establishments
          had an inspection on file to score.
        </p>

        <h2>How dietary tags are assigned</h2>
        <p>
          Dietary accommodations (vegan, vegetarian, gluten-free, halal, and so on) come first from a
          restaurant&rsquo;s own stated offerings on Google, which we treat as the strongest signal. For
          dimensions that aren&rsquo;t stated outright, we apply an automated classification pass over
          the restaurant&rsquo;s name and cuisine. These tags indicate that a place <em>offers options</em>
          for a given diet — not that it is exclusively that — and they&rsquo;re a guide, not a
          guarantee. Always confirm with the restaurant for strict dietary or allergy needs.
        </p>

        <h2>Limitations — read these</h2>
        <p>
          An inspection is a snapshot; conditions change day to day, and a single report may not reflect
          a restaurant&rsquo;s long-term operation. Our score is a heuristic built on top of that public
          data, not a medical or official safety determination. Google ratings and counts shift over
          time. We refresh from the source on a regular cycle, and each restaurant page shows when its
          data was last updated. <strong>Found something wrong?</strong> Tell us at
          <a href="mailto:rohan@centralfloridataste.org">rohan@centralfloridataste.org</a> and
          we&rsquo;ll correct it.
        </p>
      </div>

      <nav class="trustlinks" aria-label="Trust and transparency">
        <a href="/data-sources/">Data &amp; sources</a>
        <a href="/about/">About this guide</a>
      </nav>

      {/* Additive Q&A. Each question is its own H2 with a direct one-sentence
          answer on the first line beneath it, then the supporting detail. */}
      <section aria-labelledby="questions-h">
        <h2 id="questions-h">Common questions about Florida restaurant inspections</h2>
        <p>
          Short answers first, detail underneath. Every figure below describes the
          {' '}{cov.published.toLocaleString('en-US')} restaurants we publish of the
          {' '}{cov.licensed.toLocaleString('en-US')} licensed food service establishments across the
          {' '}{cov.counties} counties we cover.
          {cov.nr > 0 && (
            <>
              {' '}{cov.nr}{' '}{cov.nr === 1 ? 'restaurant is' : 'restaurants are'} excluded from
              grade percentages, having no recent scoreable inspection on file;{' '}
              {cov.graded.toLocaleString('en-US')} are graded.
            </>
          )}
        </p>
      </section>

      {qa.map((x) => (
        <section aria-labelledby={x.id}>
          <h2 id={x.id}>{x.q}</h2>
          <p class="qa-direct">{x.a}</p>
          <p>{x.more}</p>
        </section>
      ))}

      <section aria-labelledby="viol-more-h">
        <h2 id="viol-more-h">Violations explained in detail</h2>
        <ul class="link-list">
          <li><a href="/violations/">All violation types</a> &mdash; the three tiers and the most-cited codes</li>
          {tiers.map((t) => (
            <li><a href={`/violations/${t.slug}/`}>{t.title}</a> &mdash; {t.total.toLocaleString('en-US')} recorded, &minus;{t.penalty} {t.penalty === 1 ? 'point' : 'points'} each</li>
          ))}
          <li><a href="/violations/emergency-orders/">Emergency orders</a> &mdash; {em.total} restaurants with one on record</li>
        </ul>
      </section>
    </article>
  </main>
  <style>
    .qa-direct { font-size: 1.05rem; font-weight: 600; color: var(--ink); margin: 0 0 0.5rem; }
  </style>
</Base>
