---
import Base from '../../layouts/Base.astro';
import RestaurantCard from '../../components/RestaurantCard.astro';
import { counties, cities } from '../../lib/data.js';
import { countyFilters, cityFilters, sortFilters, specialByCity, specialByCounty } from '../../lib/manifest.js';
import { countyHubLinks, cityHubLinks } from '../../lib/hublinks.js';
import { titleCase, sortForHub } from '../../lib/format.js';
import { hubIntro } from '../../lib/prose.js';
import { countyFailureStats } from '../../lib/failed-inspections.js';
import ListIntro from '../../components/ListIntro.astro';

// County hubs (/[county_slug]-county/) and city hubs (/[city_slug]/) both live at
// the root as single dynamic segments — Astro permits one dynamic route per path
// position, so they're generated together here and branched on `type`.
export function getStaticPaths() {
  const paths = [];
  for (const c of counties) {
    paths.push({
      params: { slug: `${c.slug}-county` },
      props: { type: 'county', slug: c.slug, name: c.name, items: c.items },
    });
  }
  for (const c of cities) {
    paths.push({
      params: { slug: c.slug },
      props: { type: 'city', slug: c.slug, name: c.name, items: c.items },
    });
  }
  return paths;
}

const { type, slug, name, items } = Astro.props;
const isCounty = type === 'county';

const sorted = [...items].sort(sortForHub);
const aGrade = items.filter((r) => r.health_grade === 'A').length;
const pctA = items.length ? Math.round((aGrade / items.length) * 100) : 0;
const rated = items.filter((r) => Number.isFinite(r.rating));
const avgRating = rated.length ? (rated.reduce((s, r) => s + r.rating, 0) / rated.length).toFixed(1) : null;
const displayName = isCounty ? name : titleCase(name);

// City hubs sit under their county; county hubs link down to their city hubs.
const countyOfCity = isCounty ? null : { slug: items[0].county_slug, name: items[0].county };
const cityHubsInCounty = isCounty
  ? cities
      .filter((c) => c.items[0].county_slug === slug)
      .sort((a, b) => b.items.length - a.items.length)
  : [];

// Dietary/cuisine filter pages available for this area (reverse links, no orphans).
const ownFilters = sortFilters((isCounty ? countyFilters.get(slug) : cityFilters.get(slug)) || []);

/* Complete hub-to-hub coverage (see lib/hublinks.js). A county hub links every
   guide beneath it — for every city, hub or not, plus its neighborhoods — so no
   combo hub depends on being reachable only via the sitemap. A city hub links
   its own guides, its parent county and its sibling cities. */
const countyLinks = isCounty ? countyHubLinks(slug) : null;
// Failed-inspections page exists only where the county has >=4 published F grades.
const failStats = isCounty ? countyFailureStats(slug) : null;
const hasFailPage = !!failStats && failStats.fCount >= 4;
const cityLinks = isCounty ? null : cityHubLinks(slug);

// Health-score "special" pages for this area.
const specials = (isCounty ? specialByCounty.get(slug) : specialByCity.get(slug)) || [];

const pageUrl = new URL(isCounty ? `/${slug}-county/` : `/${slug}/`, Astro.site).href;

const geoLabel = isCounty ? `${displayName} County` : displayName;
const h1 = `${geoLabel} Restaurant Health Grades`;
// Data-driven intro: opens on whatever is most distinctive about THIS area's
// data (grade mix, a local wedge, dominant cuisine, scale) — see lib/prose.js.
const hub = hubIntro({ type, displayName, slug, items });

const seoTitle = `${geoLabel} Restaurant Health Grades${isCounty ? '' : ', FL'}`.slice(0, 60);
// Not "official": Florida issues no official grades — ours are calculated from
// DBPR's public inspection records (see /methodology/).
const seoDescription = (
  `${geoLabel} restaurant health grades: browse ${items.length} restaurants by our A–F ` +
  `inspection score, plus dietary options and diner ratings.`
).slice(0, 155);

// FAQ — targets "{place} restaurant health grades" intent + FAQPage rich results.
const faqs = [
  {
    q: `How are ${geoLabel} restaurant health grades calculated?`,
    a: `Florida issues no official grades, so we calculate an A–F score from each restaurant's most recent DBPR inspection — starting at 100 points and deducting for high-priority, intermediate, and basic violations. Of the ${items.length} ${geoLabel} restaurants we grade, ${aGrade} currently hold an A.`,
  },
  {
    q: `Does Florida assign letter grades to ${geoLabel} restaurants?`,
    a: `No. The Florida Department of Business and Professional Regulation (DBPR) inspects restaurants and records violations but does not grade them. The grades shown here are calculated by us from those public inspection records.`,
  },
  {
    q: `How many restaurants are graded in ${geoLabel}?`,
    a: `We currently publish ${items.length} graded restaurants in ${geoLabel}${avgRating ? `, with an average diner rating of ${avgRating} stars` : ''}; ${aGrade} hold an A health grade.`,
  },
];
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

/* ---------- JSON-LD: CollectionPage + ItemList + BreadcrumbList ---------- */
const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: h1,
  url: pageUrl,
  description: seoDescription,
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: sorted.length,
    itemListElement: sorted.map((r, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: new URL(`${r.url}/`, Astro.site).href,
      name: r.name,
    })),
  },
};

const crumbs = [{ name: 'Home', item: new URL('/', Astro.site).href }];
if (!isCounty) {
  crumbs.push({
    name: `${countyOfCity.name} County`,
    item: new URL(`/${countyOfCity.slug}-county/`, Astro.site).href,
  });
}
crumbs.push({ name: isCounty ? `${displayName} County` : displayName, item: pageUrl });
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: crumbs.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.name,
    item: c.item,
  })),
};
---

<Base title={seoTitle} description={seoDescription}>
  <script
    type="application/ld+json"
    slot="jsonld"
    set:html={JSON.stringify([collectionSchema, breadcrumbSchema, faqSchema])}
  />

  <main>
    <nav aria-label="Breadcrumb">
      <a href="/">Home</a> &rsaquo;
      {!isCounty && (
        <>
          <a href={`/${countyOfCity.slug}-county/`}>{countyOfCity.name} County</a> &rsaquo;
        </>
      )}
      <span>{isCounty ? `${displayName} County` : displayName}</span>
    </nav>

    <article>
      <p class="eyebrow">{isCounty ? 'County hub' : 'City hub'} · Updated June 2026</p>
      <h1>{h1}</h1>
      <div class="statrow">
        <div class="stat"><b>{pctA}%</b><span>Grade A</span></div>
        {avgRating && <div class="stat"><b>{avgRating}</b><span>Avg rating</span></div>}
        <div class="stat"><b>{items.length}</b><span>Restaurants</span></div>
        {isCounty && cityHubsInCounty.length > 0 && (
          <div class="stat"><b>{cityHubsInCounty.length}</b><span>Cities</span></div>
        )}
      </div>
      <ListIntro intro={hub} pclass="lead" />

      {isCounty && cityHubsInCounty.length > 0 && (
        <section aria-labelledby="cities-h">
          <h2 id="cities-h">Cities in {displayName} County</h2>
          <ul class="chiplist">
            {cityHubsInCounty.map((c) => (
              <li><a href={`/${c.slug}/`}>{titleCase(c.name)} <span class="ct">{c.items.length}</span></a></li>
            ))}
          </ul>
        </section>
      )}

      {/* Inspection-records page for this county. Its own block, not nested in
          the specials section — counties without a worst-scores page (St. Lucie)
          would otherwise lose the link entirely. */}
      {isCounty && (
        <section aria-labelledby="inspections-h">
          <h2 id="inspections-h">{displayName} County inspection records</h2>
          <ul class="link-list">
            <li>
              <a href={`/${slug}-county/restaurant-inspections/`}>{displayName} County restaurant inspections</a>
              {' '}&mdash; grade distribution, most-cited violations and recent enforcement actions
            </li>
            {hasFailPage && (
              <li>
                <a href={`/${slug}-county/failed-inspections/`}>{displayName} County failed inspections</a>
                {' '}&mdash; F and D grades, emergency orders and the violations behind them
              </li>
            )}
          </ul>
        </section>
      )}

      {specials.length > 0 && (
        <section aria-labelledby="favorites-h">
          <h2 id="favorites-h">Health &amp; local favorites</h2>
          <ul class="link-list">
            {specials.map((p) => (
              <li><a href={`${p.url}/`}>{p.label} in {p.geoName}{p.geoType === 'county' ? ' County' : ''}</a> ({p.items.length})</li>
            ))}
          </ul>
        </section>
      )}

      {ownFilters.length > 0 && (
        <section aria-labelledby="browse-h">
          <h2 id="browse-h">Browse {displayName}{isCounty ? ' County' : ''} by diet &amp; cuisine</h2>
          <ul class="link-list">
            {ownFilters.map((p) => (
              <li>
                <a href={`${p.url}/`}>{p.label}{p.kind === 'cuisine' ? ' restaurants' : ''}</a> ({p.items.length})
              </li>
            ))}
          </ul>
        </section>
      )}

      {/* Complete guide coverage for this county: every city (hub or not) and
          every neighborhood, with all of their diet, cuisine and health-score
          guides — server-rendered, nothing truncated. */}
      {isCounty && (countyLinks.byCity.length > 0 || countyLinks.districtGroups.length > 0) && (
        <section aria-labelledby="more-guides-h">
          <h2 id="more-guides-h">All {displayName} County guides by city</h2>
          <ul class="link-list">
            {countyLinks.byCity.map((g) => (
              <li>
                <strong>{g.hasHub ? <a href={`/${g.citySlug}/`}>{g.city}</a> : g.city}:</strong>{' '}
                {g.pages.map((p, i) => (
                  <>
                    {i > 0 && ', '}
                    <a href={p.url}>{p.label}</a>
                  </>
                ))}
              </li>
            ))}
            {countyLinks.districtGroups.map((d) => (
              <li>
                <strong><a href={d.url}>{d.name}</a>:</strong>{' '}
                {d.pages.length === 0
                  ? 'neighborhood guide'
                  : d.pages.map((p, i) => (
                      <>
                        {i > 0 && ', '}
                        <a href={p.url}>{p.label}</a>
                      </>
                    ))}
              </li>
            ))}
          </ul>
          <p class="src"><a href="/guides/">Browse every guide on the site &rarr;</a></p>
        </section>
      )}

      {/* City hub: parent county + sibling cities, so city hubs interlink. */}
      {!isCounty && cityLinks && (cityLinks.county || cityLinks.siblings.length > 0) && (
        <section aria-labelledby="nearby-h">
          <h2 id="nearby-h">Nearby &amp; related guides</h2>
          <ul class="link-list">
            {cityLinks.county && (
              <li><a href={cityLinks.county.url}>{cityLinks.county.label}</a> ({cityLinks.county.count})</li>
            )}
            {cityLinks.siblings.map((c) => (
              <li><a href={c.url}>{c.label}</a> ({c.count})</li>
            ))}
          </ul>
          <p class="src"><a href="/guides/">Browse every guide on the site &rarr;</a></p>
        </section>
      )}

      <section aria-labelledby="all-h">
        <h2 id="all-h">All {items.length} restaurants</h2>
        <ul class="cards">
          {sorted.map((r) => <RestaurantCard r={r} />)}
        </ul>
      </section>

      <section id="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">{geoLabel} restaurant health grades — FAQ</h2>
        <div class="prose">
          {faqs.map((f) => (
            <>
              <h3>{f.q}</h3>
              <p>{f.a}</p>
            </>
          ))}
          <p>See the full scoring method on our <a href="/methodology/">methodology page</a>.</p>
        </div>
      </section>
    </article>
  </main>
</Base>
